{
  "name": "tierkit-vscode",
  "displayName": "Tierkit",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to a running `tierkit runtime` from inside VS Code: route routing, command classification, usage, and a status bar entry for daemon health.",
  "license": "MIT",
  "publisher": "leesiwal",
  "engines": {
    "vscode": "^1.84.0",
    "node": ">=20.10.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "tierkit",
    "ai",
    "model routing",
    "ollama",
    "anthropic",
    "openai",
    "roo",
    "cline",
    "continue",
    "local-first"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeSiWal/Tierkit.git",
    "directory": "packages/vscode-tierkit"
  },
  "bugs": {
    "url": "https://github.com/LeeSiWal/Tierkit/issues"
  },
  "homepage": "https://github.com/LeeSiWal/Tierkit#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tierkit",
          "title": "Tierkit",
          "icon": "media/tierkit.svg"
        }
      ]
    },
    "views": {
      "tierkit": [
        {
          "type": "webview",
          "id": "tierkit.sidebar",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      { "command": "tierkit.focusSidebar",  "title": "Tierkit: Focus dashboard sidebar" },
      { "command": "tierkit.health",        "title": "Tierkit: Check runtime health" },
      { "command": "tierkit.routeExplain",  "title": "Tierkit: Explain route for current task" },
      { "command": "tierkit.routeRun",      "title": "Tierkit: Run task through Tierkit (streamed)" },
      { "command": "tierkit.checkCommand",  "title": "Tierkit: Classify a shell command" },
      { "command": "tierkit.usage",         "title": "Tierkit: Show usage summary" },
      { "command": "tierkit.sessionStatus", "title": "Tierkit: Show workflow session status" }
    ],
    "configuration": {
      "title": "Tierkit",
      "properties": {
        "tierkit.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4101",
          "description": "Base URL of the Tierkit runtime daemon."
        },
        "tierkit.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a Tierkit status bar item with daemon health."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.vsix .tsbuildinfo",
    "prepublish:check": "node -e \"const p=require('./package.json'); if(p.publisher==='tierkit-placeholder'){console.error('ABORT: package.json::publisher is still the placeholder. Edit it to your actual VS Code Marketplace publisher id before publishing.'); process.exit(1)} if(!require('fs').existsSync('./icon.png')){console.error('ABORT: icon.png is missing. Generate one from media/tierkit.svg with: rsvg-convert -w 128 -h 128 media/tierkit.svg -o icon.png'); process.exit(1)} console.log('prepublish check ok: publisher=' + p.publisher + ', icon=icon.png present')\"",
    "package": "pnpm run prepublish:check && vsce package --no-dependencies --out tierkit-vscode-${npm_package_version}.vsix",
    "package:sideload": "vsce package --no-dependencies --allow-missing-repository --skip-license --out tierkit-vscode-${npm_package_version}.vsix",
    "publish:vsix": "pnpm run prepublish:check && vsce publish --no-dependencies",
    "vsix:install": "code --install-extension tierkit-vscode-${npm_package_version}.vsix"
  },
  "dependencies": {
    "@tierkit/client": "workspace:*",
    "@tierkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.2.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
