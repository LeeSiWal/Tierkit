{
  "name": "tierkit-vscode",
  "displayName": "Tierkit",
  "version": "0.25.0",
  "private": true,
  "description": "%description%",
  "license": "MIT",
  "publisher": "leesiwal",
  "engines": {
    "vscode": "^1.84.0",
    "node": ">=20.10.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "tierkit",
    "ai",
    "claude",
    "claude code",
    "mcp",
    "model routing",
    "anthropic gateway",
    "claude code gateway",
    "context compression",
    "ollama",
    "anthropic",
    "openai",
    "roo",
    "cline",
    "continue",
    "aider",
    "local-first",
    "secret redaction"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeSiWal/Tierkit.git",
    "directory": "packages/vscode-tierkit"
  },
  "bugs": {
    "url": "https://github.com/LeeSiWal/Tierkit/issues"
  },
  "homepage": "https://github.com/LeeSiWal/Tierkit#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tierkit",
          "title": "%viewContainer.title%",
          "icon": "media/tierkit.svg"
        }
      ]
    },
    "views": {
      "tierkit": [
        {
          "type": "webview",
          "id": "tierkit.sidebar",
          "name": "%view.dashboard.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "tierkit.focusSidebar",
        "title": "%commands.focusSidebar%"
      },
      {
        "command": "tierkit.openInPanel",
        "title": "Tierkit: Open in main editor (mobile-friendly)"
      },
      {
        "command": "tierkit.health",
        "title": "%commands.health%"
      },
      {
        "command": "tierkit.routeExplain",
        "title": "%commands.routeExplain%"
      },
      {
        "command": "tierkit.routeRun",
        "title": "%commands.routeRun%"
      },
      {
        "command": "tierkit.checkCommand",
        "title": "%commands.checkCommand%"
      },
      {
        "command": "tierkit.usage",
        "title": "%commands.usage%"
      },
      {
        "command": "tierkit.sessionStatus",
        "title": "%commands.sessionStatus%"
      },
      {
        "command": "tierkit.restartDaemon",
        "title": "%commands.restartDaemon%"
      },
      {
        "command": "tierkit.showOutput",
        "title": "%commands.showOutput%"
      },
      {
        "command": "tierkit.addModelProfile",
        "title": "%commands.addModelProfile%"
      },
      {
        "command": "tierkit.toggleGatewayMode",
        "title": "%commands.toggleGatewayMode%"
      },
      {
        "command": "tierkit.launchClaudeCodeWithGateway",
        "title": "%command.launchClaudeCodeWithGateway%",
        "category": "Tierkit"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "tierkit.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4101",
          "description": "%configuration.baseUrl%"
        },
        "tierkit.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.statusBar%"
        },
        "tierkit.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoStartDaemon%"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm -F @tierkit/cli build && tsup && node scripts/copy-samples.mjs && node scripts/copy-cli.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist samples *.vsix .tsbuildinfo",
    "prepublish:check": "node -e \"const p=require('./package.json'); if(p.publisher==='tierkit-placeholder'){console.error('ABORT: package.json::publisher is still the placeholder. Edit it to your actual VS Code Marketplace publisher id before publishing.'); process.exit(1)} if(!require('fs').existsSync('./icon.png')){console.error('ABORT: icon.png is missing. Generate one from media/tierkit.svg with: rsvg-convert -w 128 -h 128 media/tierkit.svg -o icon.png'); process.exit(1)} console.log('prepublish check ok: publisher=' + p.publisher + ', icon=icon.png present')\"",
    "package": "pnpm run prepublish:check && vsce package --no-dependencies --out tierkit-vscode-${npm_package_version}.vsix",
    "package:sideload": "vsce package --no-dependencies --allow-missing-repository --skip-license --out tierkit-vscode-${npm_package_version}.vsix",
    "publish:vsix": "pnpm run prepublish:check && vsce publish --no-dependencies",
    "vsix:install": "code --install-extension tierkit-vscode-${npm_package_version}.vsix"
  },
  "dependencies": {
    "@tierkit/adapter-cline": "workspace:*",
    "@tierkit/adapter-continue": "workspace:*",
    "@tierkit/adapter-roo": "workspace:*",
    "@tierkit/agent": "workspace:*",
    "@tierkit/client": "workspace:*",
    "@tierkit/core": "workspace:*",
    "@tierkit/plugin-superpowers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.2.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
