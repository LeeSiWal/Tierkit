# Ignore everything by default and re-include only what the extension actually needs.
**

# Re-include the compiled extension + manifest + license + readme + icon + media (sidebar icon).
!dist/**
!package.json
!LICENSE
!README.md
!icon.png
!CHANGELOG.md
!media/**
!package.nls.json
!package.nls.*.json
!l10n/**
# Bundled sample plugins (copied here by scripts/copy-samples.mjs). The extension's
# loadBundledSamples() resolves this path at runtime so the .vsix doesn't need
# @tierkit/plugin-superpowers in node_modules.
!samples/**

# v0.20.7: Bundled self-contained Tierkit CLI (copied by scripts/copy-cli.mjs).
# Used by Claude Code MCP auto-wire so the user doesn't need a global tierkit
# install. The Extension passes <extensionPath>/cli/index.js to the daemon as
# the MCP server's `command` target.
!cli/**

# Exclude sourcemaps from the published .vsix (keep dist/extension.js only).
dist/**/*.map

# Standard noise.
**/.DS_Store
**/.git/**
**/node_modules/**
**/test/**
**/*.tsbuildinfo
tsconfig*.json
tsup.config.*
vitest.config.*
src/**
